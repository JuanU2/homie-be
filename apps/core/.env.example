# Copy to .env and fill in real values.

# PostgreSQL (docker-compose: postgis/postgis:16-3.4)
DATABASE_URL=postgresql://homie:homie@localhost:5432/homie

# RabbitMQ (docker-compose: rabbitmq:3-management)
RABBITMQ_URL=amqp://homie:homie@localhost:5672

# Google Sign-In OAuth client id
GOOGLE_CLIENT_ID=<your-google-client-id>

# S3-compatible object storage (MinIO runs separately; not in docker-compose.yml)
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=images

# Firebase service account for push notifications (optional; push disabled if unset)
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
