# Copy to .env and fill in real values.

# PostgreSQL (docker-compose: postgis/postgis:16-3.4)
DATABASE_URL=postgresql://homie:homie@localhost:5432/homie

# RabbitMQ (docker-compose: rabbitmq:3-management)
RABBITMQ_URL=amqp://homie:homie@localhost:5672

# Google Sign-In OAuth client id
GOOGLE_CLIENT_ID=<your-google-client-id>

# Google Gemini
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-3.8-flash

# Geocoding (geocode.maps.co)
GEOCODING_API_KEY=<your-geocoding-api-key>
GEOCODING_BASE_URL=https://geocode.maps.co/search

# Optional: port override (defaults to 3002)
#WORKER_PORT=3002

# Disable the RabbitMQ event consumer (required on serverless hosts like Vercel,
# where persistent connections can't run). Defaults to true.
#ENABLE_EVENT_CONSUMER=false
